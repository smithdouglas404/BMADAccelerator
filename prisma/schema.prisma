// Agentic Working Backwards Studio data model. The use case is the central object; the
// Studio is the conversational source of truth, and Git and Linear are projections of it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UseCase {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  // The owner's own first words about the product, kept verbatim.
  description       String    @default("")
  // Who it is for and where in their business: each customer's use cases are kept apart (memory, agents).
  customer          String    @default("")
  businessArea      String    @default("")
  // The short description from the new use case form (the vibing box is description).
  summary           String    @default("")
  // Where the person was last, so opening it again picks up there.
  lastView          String    @default("")
  // The product in one breath (Whole product view).
  statement         String    @default("")
  category          String    @default("")
  audience          String    @default("")
  stageLabel        String    @default("Discovery → pilot")
  customerQuote     String    @default("")
  // The living PRFAQ (Markdown): press release, customer FAQs, internal FAQs.
  prfaq             String    @default("")
  prfaqUpdatedAt    DateTime?
  // The validated use case and its signals (problem, customer, evidence, proof, thinSlice).
  validatedUseCase  String    @default("")
  validation        Json      @default("{}")
  // The capability the Muse is holding now, and the owner / engineer lens.
  // The UX / Component Mapper's shadcn/ui map and the Product Engineer's technical notes.
  components        Json      @default("[]") // [{ name, why }]
  techNotes         String[]  @default([])
  focus             String    @default("")
  lens              String    @default("owner") // owner | engineer
  session           Int       @default(1)
  floorSeq          Int       @default(0)
  repoUrl           String    @default("")
  gitBranch         String    @default("studio")
  gitStatus         String    @default("")
  gitPushedAt       DateTime?
  linearTeam        String    @default("")
  linearStatus      String    @default("")
  linearSyncedAt    DateTime?
  claudeSessionId   String    @default("")
  provisioned       Boolean   @default(false)
  // The Muse has opened the studio for this use case (PRFAQ, capabilities, first build).
  started           Boolean   @default(false)
  agentBusy         Boolean   @default(false)
  agentStatus       String    @default("")
  agentError        String    @default("")
  // Generate loop, package iterations and live preview
  generateSessionId String    @default("")
  generateBusy      Boolean   @default(false)
  generateStatus    String    @default("")
  generateCount     Int       @default(0)
  packageCount      Int       @default(0)
  lastGeneratedAt   DateTime?
  previewPort       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  skills        UseCaseSkill[]
  documents     Document[]
  messages      Message[]
  recordings    Recording[]
  feedback      Feedback[]
  events        AgentEvent[]
  capabilities  Capability[]
  decisions     Decision[]
  backlog       BacklogItem[]
  evidence      Evidence[]
  moves         Move[]
  routes        AgentRoute[]
  spec          SpecSection[]
  specRevisions SpecRevision[]
  members       Member[]
  truthChanges  TruthChange[]
  appAgents     AppAgent[]
  // The shared agent service's app token and callback secret for this product (encrypted).
  agentToken    String    @default("")
  agentSecret   String    @default("")
}

// The "why did this change?" timeline of the Product Truth Graph: one row per real change to a node,
// with what caused it (other node ids) and who made it. Written only when something happens.
model TruthChange {
  id        String   @id @default(cuid())
  useCaseId String
  node      String // e.g. spec:prd-flows, decision:<id>, ann:<id>, evidence:<id>, version:3
  kind      String // said | added | changed | approved | rejected | undone | reviewed | interpreted | observed | built
  summary   String
  before    String   @default("")
  after     String   @default("")
  causes    String[] @default([])
  by        String   @default("")
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@index([useCaseId, createdAt])
}

// The people working on a product, each with a role (product owner, business analyst, product
// engineer...). One shared source: everyone sees and changes the same product truth.
model Member {
  id        String   @id @default(cuid())
  useCaseId String
  name      String
  role      String   @default("Product owner")
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// A capability area of the product, with its floor items and how close it is to its ceiling.
model Capability {
  id          String   @id @default(cuid())
  useCaseId   String
  key         String
  label       String
  kicker      String   @default("")
  description String   @default("")
  readiness   Int      @default(0)
  delta       String   @default("")
  signal      String   @default("")
  color       String   @default("")
  position    Int      @default(0)
  // Floor items: [{ id: "F12", text, state: confirmed | assumed | out }]
  items       Json     @default("[]")
  updatedAt   DateTime @updatedAt
  useCase     UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, key])
}

// The human-in-the-loop register: decisions approved by a "yes", assumptions, and open questions.
model Decision {
  id             String    @id @default(cuid())
  useCaseId      String
  text           String
  status         String    @default("approved") // approved | assumed | open | rejected
  capability     String    @default("")
  words          String    @default("") // the owner's original words
  agent          String    @default("Muse")
  options        Json      @default("[]") // [{ label, value }] for a human-in-the-loop choice
  answer         String    @default("")
  session        Int       @default(1)
  includeInBuild Boolean   @default(true)
  builtInVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  useCase        UseCase   @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// Everything the owner thought of: captures, capability signals, parked thoughts, Muse recommendations.
model BacklogItem {
  id             String   @id @default(cuid())
  useCaseId      String
  title          String
  note           String   @default("")
  kind           String   @default("capture") // capture | epic | distraction
  group          String   @default("Unsorted signal")
  source         String   @default("Working session")
  // A Muse recommendation: consider | workflow | hitl; empty for the owner's own thoughts.
  recKind        String   @default("")
  probe          String   @default("") // the question the Muse asks when it is pulled forward
  state          String   @default("held") // suggested | held | probing | ready | built
  hidden         String   @default("") // capability | epic | story | task | workflow (engineer lens)
  includeInBuild Boolean  @default(false)
  builtInVersion Int      @default(0)
  annotationId   String   @default("")
  trackerId      String   @default("")
  trackerUrl     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  useCase        UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

model Evidence {
  id         String   @id @default(cuid())
  useCaseId  String
  source     String
  type       String   @default("conversation") // interview | research | uploaded | conversation
  insight    String
  confidence String   @default("medium") // high | medium | open
  trace      String   @default("")
  documentId String   @default("")
  createdAt  DateTime @default(now())
  useCase    UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// Build moves on the "Make it real" board, each traced to a capability and a decision.
model Move {
  id         String   @id @default(cuid())
  useCaseId  String
  title      String
  capability String   @default("")
  decision   String   @default("")
  status     String   @default("queued") // queued | ready | building | review | done
  owner      String   @default("Product Engineer")
  signal     String   @default("")
  hidden     String   @default("story")
  components String[] @default([])
  routes     String[] @default([])
  prompt     String   @default("")
  position   Int      @default(0)
  trackerId  String   @default("")
  trackerUrl String   @default("")
  // Who or what last moved the card, and why (the Muse, a build, a person's answer). People never have to.
  movedBy    String   @default("")
  moveReason String   @default("")
  updatedAt  DateTime @updatedAt
  useCase    UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// The agent route: Muse / Interviewer, Use Case Validator, UX / Component Mapper, Product Engineer.
model AgentRoute {
  id        String   @id @default(cuid())
  useCaseId String
  agent     String
  action    String   @default("")
  state     String   @default("waiting") // complete | active | ready | waiting
  detail    String   @default("")
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, agent])
}

// The living specification: PRD and TRD sections the Muse and its team fill from the conversation,
// evidence and annotations. Every section keeps its provenance (trace) and the owner's review.
model SpecSection {
  id           String   @id @default(cuid())
  useCaseId    String
  tab          String // prd | trd
  key          String // stable id, e.g. prd-use-case, trd-data
  ref          String   @default("") // PR-001 / TR-001, permanent
  title        String
  kicker       String   @default("")
  content      String   @default("")
  completeness Int      @default(0)
  confidence   String   @default("open") // high | medium | open
  basis        String   @default("not-researched") // confirmed | recommended | inferred | open | not-researched
  status       String   @default("draft") // draft | exploring | evidence-backed | owner-approved | engineer-reviewed | ready-prototype | ready-pilot | production-ready
  review       String   @default("") // keep | revise | challenge | remove (the owner's last review)
  reviewNote   String   @default("")
  source       String   @default("")
  capability   String   @default("")
  related      String[] @default([]) // backlog, move, decision, evidence ids or refs
  trace        Json     @default("[]") // [{label, detail, type}]
  position     Int      @default(0)
  updatedBy    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  useCase      UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, key])
}

// A versioned snapshot of the spec, taken with every package, with the plain diff from the one before.
model SpecRevision {
  id        String   @id @default(cuid())
  useCaseId String
  version   Int
  reason    String   @default("")
  snapshot  Json     @default("[]")
  diff      String   @default("")
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, version])
}

model UseCaseSkill {
  id        String  @id @default(cuid())
  useCaseId String
  skillId   String
  useCase   UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, skillId])
}

model Document {
  id          String   @id @default(cuid())
  useCaseId   String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  kind        String   @default("other") // evidence type the document agent picked
  tags        String[] @default([])
  description String   @default("")
  summary     String   @default("")
  approved    Boolean  @default(false)
  status      String   @default("in_review") // in_review | approved | declined
  declineNote String   @default("")
  origin      String   @default("upload") // upload | studio
  textPath    String   @default("")
  createdAt   DateTime @default(now())
  useCase     UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  useCaseId String
  role      String // user | muse | signal | agent
  agent     String   @default("") // who spoke: Muse, a specialist, or a signal label
  accent    String   @default("") // capability key the message belongs to
  content   String
  // The person who spoke (several people can work on one product) and their role.
  author     String  @default("")
  authorRole String  @default("")
  // Who they addressed: "" for the Muse, or a specialist's key.
  addressed  String  @default("")
  // The words as spoken, when the message was cleaned up from voice.
  raw        String  @default("")
  // The decision a "Decision captured" signal recorded, so it can be undone.
  ref        String  @default("")
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// Voice drafts: recordings with no time limit; continue, save or submit.
model Recording {
  id         String   @id @default(cuid())
  useCaseId  String
  purpose    String   @default("describe")
  transcript String   @default("")
  status     String   @default("draft") // draft | submitted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  useCase    UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

model Preferences {
  id                String  @id @default("global")
  // Claude Code's .claude/skills is always on; these add more tool targets.
  targetCodex       Boolean @default(false)
  targetCursor      Boolean @default(false)
  targetAntigravity Boolean @default(false)
  // ECC library skills switched on for every product (per-product picks are UseCaseSkill rows).
  eccAllProducts    String[] @default([])
}

// Visual markup on a generated screen: the drawing, the comment, and the card it became.
model Feedback {
  id        String   @id @default(cuid())
  useCaseId String
  comment   String
  imagePath String
  pageUrl   String   @default("")
  target    String   @default("") // the surface the owner pointed at
  shape     String   @default("object") // object | circle | full-screen
  status    String   @default("new") // new | built
  // The Muse's reading of the mark: observation, desired behaviour, acceptance criteria, component change,
  // the PRD and TRD sections it changes, and any question (the annotation interpretation chain).
  interpretation Json @default("{}")
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// Queue of things the Muse must hear (messages, captures, moves, annotations, build notes),
// run one at a time per use case.
model AgentEvent {
  id        String   @id @default(cuid())
  useCaseId String
  kind      String // user | move | feedback | generate | review | start
  prompt    String
  // The Product Truth Graph node that caused this turn (msg:…, ann:…, evidence:…), so every change the
  // Muse makes in it can say why.
  cause     String   @default("")
  status    String   @default("queued") // queued | running | done | failed
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  useCase   UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
}

// Skills a team uploaded, validated before they are switched on.
model CustomSkill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  path        String
  valid       Boolean  @default(false)
  report      String   @default("")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Keys and models set on the Settings page. Keys are stored encrypted (AES-256-GCM, see src/lib/settings.ts)
// and never sent back to the browser; only the last four characters are shown.
model StoredKey {
  name      String   @id // the environment variable, e.g. ANTHROPIC_API_KEY
  cipher    String
  last4     String
  updatedAt DateTime @updatedAt
}

model ModelChoice {
  role      String   @id // the environment variable, e.g. BACC_MODEL
  model     String
  updatedAt DateTime @updatedAt
}

// MCP connectors (data sources and tools) the Studio's agents can use. Switched on for every
// product, or only for the products that pick them.
model McpServer {
  id           String   @id @default(cuid())
  name         String   @unique // short key the agents see, e.g. "notion"
  label        String   @default("")
  transport    String   @default("http") // http | sse | stdio
  url          String   @default("")
  command      String   @default("")
  args         String[] @default([])
  // Headers or environment values, stored encrypted like keys (AES-256-GCM), never sent to the browser.
  secretCipher String   @default("")
  secretNames  String[] @default([])
  enabled      Boolean  @default(true)
  allProducts  Boolean  @default(true)
  useCases     String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// An agent a product needs, as configuration for the shared agent service (CLAUDE.md, "Agent memory:
// Mem0 + Letta"). The Muse proposes it; a person approves it; the Studio registers it.
model AppAgent {
  id           String   @id @default(cuid())
  useCaseId    String
  useCase      UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  key          String
  name         String
  purpose      String
  instructions String
  // Every agent has a Letta persona unless a person explicitly said no.
  persona      Boolean  @default(true)
  personaText  String   @default("")
  provider     String   @default("anthropic")
  model        String   @default("")
  tools        Json     @default("[]")
  approvals    Json     @default("{}")
  facts        Boolean  @default(true)
  // proposed (waiting for a person), approved (registered and running), off (rejected or switched off)
  status       String   @default("proposed")
  decisionId   String   @default("")
  why          String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([useCaseId, key])
}
