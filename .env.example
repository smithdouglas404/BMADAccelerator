# Postgres connection. docker-compose sets this for you.
DATABASE_URL="postgresql://bacc:bacc@localhost:5432/bacc"

# Voice transcription (ElevenLabs speech-to-text). Leave empty to turn voice off.
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v1"

# The Muse, its specialists, the document agent and Claude Code (API fallback; the Claude plan is preferred).
ANTHROPIC_API_KEY=""

# Where each product's workspace lives. Defaults to ./workspaces.
WORKSPACES_DIR=""

# Voice for reading questions aloud (optional; a default ElevenLabs voice is used).
ELEVENLABS_VOICE_ID=""

# Optional trackers. Linear: a personal API key (Settings > Security & access in Linear).
LINEAR_API_KEY=""
# TypeSafe (Jev), for typed yes/no, choice and score answers (console at typesafe.ai). Best saved on Settings > Models and keys.
TYPESAFE_API_KEY=""
# Jira Cloud export: your site, account email and an API token (id.atlassian.com).
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Ports for the generated apps, one per product. Move the range if another program
# on your computer already uses one of them.
BACC_PREVIEW_PORT_BASE="4100"
BACC_PREVIEW_PORT_LAST="4129"

# Agent memory (Mem0 + Letta, self-hosted in Docker). Run scripts/memory-secrets.sh once to fill
# these three passwords; they stay on this computer.
MEM0_ADMIN_API_KEY=""
MEM0_JWT_SECRET=""
LETTA_SERVER_PASSWORD=""
# OpenAI key for memory (Mem0's lesson model and embeddings, Letta's embeddings) and for the AI
# images Generate puts in apps (a few cents each, at most BACC_IMAGE_LIMIT per Generate).
OPENAI_API_KEY=""
# Optional overrides (defaults match the owner's other Mem0 and Letta).
MEM0_DEFAULT_LLM_MODEL="gpt-5-mini"
MEM0_DEFAULT_EMBEDDER_MODEL="text-embedding-3-small"
# Images in generated apps: BACC_IMAGES="off" turns them off (Generate then draws SVG only).
BACC_IMAGES=""
BACC_IMAGE_MODEL="gpt-image-2"
BACC_IMAGE_QUALITY="medium"
BACC_IMAGE_LIMIT="12"
# The shadcn MCP server (component look-ups for the agents). "0" turns it off.
BACC_SHADCN_MCP=""
# The model key generated apps get for their own AgentKit agents: "openai" (your OpenAI key), "anthropic" or "off" (demo mode).
# Apps never get any other key.
BACC_APP_LLM="openai"
# Optional: Gemini for generated apps' agents. Any key here can also be added on Settings > Models and keys.
GEMINI_API_KEY=""
# Optional: the secret that encrypts keys saved on the Settings page (one is made for you if empty).
BACC_SECRET=""
# Partner shadcn registries the advisor searches beside @shadcn: a comma-separated list, "all" or "off".
BACC_SHADCN_REGISTRIES=""
# Optional: run the agents, Generate and the document agent on your own Claude subscription.
# Create the token with `claude setup-token`. Personal use only: a subscription isn't for other people's use.
CLAUDE_CODE_OAUTH_TOKEN=""
# plan-then-key (default with a token: switch to the API key when the plan limit is reached), plan, or key.
BACC_CLAUDE_AUTH=""
# Claude models: the Muse, its specialists and Claude Code, the document agent, and Letta's role agents.
BACC_MODEL="claude-sonnet-5-5"
BACC_DOC_MODEL="claude-haiku-5-5"
BACC_LETTA_MODEL="anthropic/claude-haiku-5-5"
BACC_LETTA_EMBEDDING=""

# The Studio's public https address, when assistants on the web (claude.ai, ChatGPT, Meta Muse) connect to it.
# Leave empty to allow only this computer (Claude Desktop, Claude Code). See docs/CONNECT.md.
STUDIO_PUBLIC_URL=

# Set to nginx-ui.conf ONLY after Cloudflare Access protects the hostname (see docs/CONNECT.md).
CONNECTOR_GATE_CONF=nginx.conf
