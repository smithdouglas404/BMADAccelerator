# Postgres connection. docker-compose sets this for you.
DATABASE_URL="postgresql://bacc:bacc@localhost:5432/bacc"

# Voice transcription (ElevenLabs speech-to-text). Leave empty to turn voice off.
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v1"

# Concierge and BMAD agents (arrives in step 2).
ANTHROPIC_API_KEY=""

# Where each use case's BMAD workspace lives. Defaults to ./workspaces.
WORKSPACES_DIR=""

# Voice for reading questions aloud (optional; a default ElevenLabs voice is used).
ELEVENLABS_VOICE_ID=""

# Optional trackers. Linear: a personal API key (Settings > Security & access in Linear).
LINEAR_API_KEY=""
# Jira Cloud export: your site, account email and an API token (id.atlassian.com).
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Ports for the generated apps, one per use case. Move the range if another program
# on your computer already uses one of them.
BACC_PREVIEW_PORT_BASE="4100"
BACC_PREVIEW_PORT_LAST="4129"

# Agent memory (Mem0 + Letta, self-hosted in Docker). Run scripts/memory-secrets.sh once to fill
# these three passwords; they stay on this computer.
MEM0_ADMIN_API_KEY=""
MEM0_JWT_SECRET=""
LETTA_SERVER_PASSWORD=""
# OpenAI key for memory: Mem0's lesson model and embeddings, and Letta's embeddings.
OPENAI_API_KEY=""
# Optional overrides (defaults match the owner's other Mem0 and Letta).
MEM0_DEFAULT_LLM_MODEL="gpt-4.1-nano-2025-04-14"
MEM0_DEFAULT_EMBEDDER_MODEL="text-embedding-3-small"
BACC_LETTA_MODEL=""
BACC_LETTA_EMBEDDING=""
